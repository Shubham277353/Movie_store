<html>

<head>
    <title>
        <%= title %>
    </title>
</head>

<body>
    <%- include("./partials/navbar") %>

    <a href="/movies/new">Create Movie</a>

        <h2>
            <%= heading %>
        </h2>

        <% movies.forEach((movie)=> { %>
            <div class="movie-card">
                <a href="/movies/<%= movie.id %>">
                    <img src="<%= movie.image_url %>" alt="<%= movie.title %> poster"
                        onerror="this.src='/images/movie-placeholder.jpg'">
                    <h3>
                        <%= movie.title %>
                    </h3>
                </a>
                <p>
                    <%= movie.year_released %>
                </p>
                <a href="/movies/<%= movie.id %>/edit">Edit</a>
            </div>
            <% }) %>

                <% if (backUrl) { %>
                    <a href="<%= backUrl %>">
                        <%= backText %>
                    </a>
                    <% } %>
</body>

</html>