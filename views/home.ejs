<html>

<head>
    <title>Home</title>
</head>

<body>
    <%- include("./partials/navbar") %>

    <h2>All Movies</h2>

    <% movies.forEach((movie)=> { %>
        <div class="movie-card">
            <a href="/movies/<%= movie.id %>">
                <h3>
                    <%= movie.title %>
                </h3>
            </a>
            <p>
                <%= movie.year_released %>
            </p>
        </div>
        <% }) %>
</body>

</html>