<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Directors</title>
    <link rel="stylesheet" href="/css/output.css">    
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">

    <%- include("./partials/navbar") %>

    <main class="mx-auto max-w-6xl px-6 py-12">

        <div class="mb-8">
            <h1 class="text-3xl font-bold tracking-tight">
                All Directors
            </h1>

            <p class="mt-2 text-slate-400">
                Browse movies by director.
            </p>
        </div>

        <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">

            <% directors.forEach((director) => { %>

                <a
                    href="/directors/<%= director.id %>"
                    class="group overflow-hidden rounded-xl border border-slate-800 bg-slate-900 transition duration-200 hover:-translate-y-1 hover:border-indigo-500 hover:bg-slate-800"
                >
                    <div class="aspect-2/3 overflow-hidden bg-slate-800">
                        <img src="<%= director.image_url %>" alt="<%= director.name %>'s image"
                            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                            onerror="this.src='/images/movie-placeholder.jpg'"
                        >
                    </div>

                    <!-- Director Information -->
                    <div class="p-4">

                        <h2 class="font-semibold text-slate-200 transition group-hover:text-indigo-400">
                            <%= director.name %>
                        </h2>

                        <p class="mt-2 text-sm text-slate-500">
                            View movies →
                        </p>

                    </div>

                </a>

            <% }) %>

        </div>

    </main>

</body>

</html>