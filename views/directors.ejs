<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genres</title>
</head>

<body>
    <%- include("./partials/navbar") %>

    <h2>All Directors</h2>
    <% directors.forEach((director)=> { %>
        <div>
            <a href="/directors/<%= director.id %>">
                <h3>
                    <%= director.name %>
                </h3>
            </a>
        </div>
        <% }) %>
</body>

</html>