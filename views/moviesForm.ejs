<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genres</title>
</head>

<body>
    <form action="/movies/new" method="post">
        <label for="title">
            <input type="text" id="title" name="title" placeholder="Inception">
        </label>

        <label for="releaseDate">Select Release Date:</label>
        <input type="date" id="releaseDate" name="releaseDate">


        <label for="director">Select a director:</label>
        <select name="director" id="director">
            <% directors.forEach((director)=> { %>
                <option value="<%= director.name %>">
                    <%= director.name %>
                </option>
                <% }) %>
        </select>

        <% genres.forEach(genre=> { %>
            <label for="<%= genre.name %>">
                <%= genre.name %>
            </label>
            <input type="checkbox" name="genres" id="<%= genre.name %>" value="<%= genre.name %>"><br>
            <% }) %>
            
    </form>
</body>

</html>